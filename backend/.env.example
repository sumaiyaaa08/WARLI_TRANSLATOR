# Backend environment (optional). Copy to `.env` and adjust, or set these in your
# shell. All have sensible defaults in app/config.py — this file just documents them.

# Data
WARLI_DATA_DIR=../data

# ASR (Whisper)
WARLI_ASR_ENABLED=true
WARLI_ASR_BACKEND=faster-whisper
WARLI_ASR_MODEL=small
WARLI_ASR_DEVICE=cpu
WARLI_ASR_COMPUTE=int8

# Translation engine: rule | seq2seq (seq2seq not wired yet)
WARLI_TRANSLATION_ENGINE=rule

# TTS (APPROXIMATION — Marathi voice reading Warli Devanagari; needs internet).
# Warli is a Marathi-family language, so 'mr' pronounces it better than 'hi'.
WARLI_TTS_ENABLED=true
WARLI_TTS_LANG=mr
WARLI_TTS_SLOW=false

# Optional pronunciation layer (fully decoupled)
WARLI_PRONUNCIATION_ENABLED=true

# API
# All JSON routes are served under this prefix; "/" serves the built frontend so
# the API + UI share one origin (single-server deploy — see the root Dockerfile).
WARLI_API_PREFIX=/api
# Where the built React app lives (frontend/dist). Served at "/" when present.
# The Docker build populates this automatically; override only if you build elsewhere.
WARLI_FRONTEND_DIST=../frontend/dist
WARLI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WARLI_MAX_UPLOAD_BYTES=26214400
