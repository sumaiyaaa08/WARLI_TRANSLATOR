# PRODUCTION frontend env (Vercel). Copy to `.env.production` OR — preferred —
# set the same variable in the Vercel dashboard (Project -> Settings ->
# Environment Variables). Vite picks up VITE_-prefixed vars from the environment
# at build time.
#
# In production there is NO dev proxy, so this MUST be the absolute public URL of
# your Render backend (no trailing slash needed). The same origin must be added to
# the backend's WARLI_CORS_ORIGINS or the browser will block the calls.
VITE_API_URL=https://warli-backend.onrender.com
