# Frontend environment (optional — copy to .env.local only if you need to override).
#
# The FastAPI backend now serves this app AND its API from ONE origin (see the
# root Dockerfile). So the default relative base "/api" works in dev (Vite proxies
# /api -> backend) AND in the single-server production build. You normally do NOT
# need to set anything.
VITE_API_URL=/api

# Only override if you deliberately host the API on a different origin:
# VITE_API_URL=https://warli-backend.onrender.com/api
