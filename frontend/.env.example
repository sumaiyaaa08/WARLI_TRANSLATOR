# Frontend environment (copy to .env.local if you need to override).
# Base URL of the FastAPI backend. In dev, Vite proxies /api -> backend, so the
# default below uses the relative /api path and needs no CORS setup.
VITE_API_URL=/api

# If you do NOT use the dev proxy, point directly at the backend instead:
# VITE_API_URL=http://127.0.0.1:8000
